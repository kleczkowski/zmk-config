#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MACOS 1
#define MOD 2
#define ADJUST 3

/ {
    combos {
        compatible = "zmk,combos";

        dbl_shift_caps_word_combo {
            bindings = <&caps_word>;
            key-positions = <40 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // --------------------------------------------------------------------------------------------------------------------------------
            // | ESC   |  1  |  2  |   3   |  4  |  5  |                   ---                |  6    |  7    |  8    |  9   | 0  |    BSPC   |
            // | TAB   |  Q  |  W  |   E   |  R  |  T  |   (   |           ---        |  )    |  Y    |  U    |  I    |  O   | P  |     -     |
            // | CTRL  |  A  |  S  |   D   |  F  |  G  |   [   |           ---        |  ]    |  H    |  J    |  K    |  L   | ;  |     '     |
            // | SHIFT |  Z  |  X  |   C   |  V  |  B  | PG_UP | PG_DOWN | --- | HOME | END   |  N    |  M    |  ,    |  .   | /  | SHFT(RET) |
            // | CRTL  | ALT | GUI | LOWER |    GUI    | LOWER | SPACE   | --- | DEL  | SPACE |     RAISE     | LEFT  | DOWN | UP |   RIGHT   |

            bindings = <
&kp GRAVE     &kp N1           &kp N2         &kp N3    &kp N4                      &kp N5                                                             &kp N6  &kp N7         &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB       &kp Q            &kp W          &kp E     &kp R                       &kp T   &lt ADJUST LPAR                           &lt ADJUST RPAR  &kp Y   &kp U          &kp I      &kp O     &kp P     &kp EQUAL
&kp ESCAPE    &kp A            &kp S          &kp D     &kp F                       &kp G   &kp LBKT                                  &kp RBKT         &kp H   &kp J          &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT     &kp Z            &kp X          &kp C     &kp V                       &kp B   &kp PG_UP        &kp PG_DN     &kp HOME   &kp END          &kp N   &kp M          &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LEFT_WIN  &lt ADJUST PLUS  &lt MOD MINUS  &kp LALT  &mt LEFT_CONTROL BACKSLASH          &kp BACKSPACE    &kp DELETE    &kp ENTER  &kp SPACE                &kp RIGHT_ALT  &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        macos_layer {
            // macOS overrides: bottom-left is Ctrl; thumb is Cmd when held and \ when tapped.

            bindings = <
&trans            &trans  &trans  &trans  &trans                  &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans  &trans  &trans  &trans                  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans  &trans  &trans  &trans                  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &trans  &trans  &trans  &mt LEFT_GUI BACKSLASH          &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod_layer {
            bindings = <
&kp F1     &kp F2       &kp F3      &kp F4          &kp F5           &kp F6                                       &kp F7           &kp F8     &kp F9     &kp F10     &kp F11         &kp F12
&sk LALT   &kp EXCL     &kp AT      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE   &trans                    &trans  &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_MINUS    &sk RALT
&sk LCTRL  &kp POUND    &kp DOLLAR  &kp LBKT        &kp RBKT         &kp GRAVE  &trans                    &trans  &kp KP_ASTERISK  &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_PLUS     &sk LCTRL
&sk LSHFT  &kp PERCENT  &kp CARET   &kp LPAR        &kp RPAR         &kp TILDE  &trans  &trans    &trans  &trans  &kp KP_NUMLOCK   &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_ENTER    &sk RSHFT
&sk LGUI   &trans       &trans      &trans          &trans                      &trans  &trans    &trans  &trans                   &trans     &kp KP_N0  &kp KP_DOT  &kp KP_NUMLOCK  &sk RGUI
            >;
        };

        control_layer {
            // -----------------------------------------------------------------------------------------
            // | MACOS |  F2   |    F3    |    F4     |     F5     | F6 |                   ---                | F7  | F8  |  F9  |  F10 | F11 | F12        |
            // | WIN/LX|       |          |           |            |    | BOOTL |           ---        |  )    | BT1 | BT2 |  BT3 |  BT4 | BT5 | OUTPUT TGL |
            // | CTRL  | MUTE  |  Vol Dn  |  Vol Up   | Play/Pause |    | RESET |           ---        |  ]    | F1  | F2  |  F3  |  F4  | F5  | F6         |
            // | SHIFT | PSCRN |  PSCRN   |   CAPS    |            |    | PG_UP | PG_DOWN | --- | HOME | END   | F7  | F8  |  F9  |  F10 | F11 | F12        |
            // | CRTL  | ALT   |  GUI     |   LOWER   |      GUI        | LOWER | SPACE   | --- | DEL  | SPACE |   RAISE   | LEFT | DOWN | UP  |   RIGHT    |

            bindings = <
&to MACOS  &trans          &mkp MB3        &trans           &trans            &trans                                                                    &bt BT_CLR      &bt BT_CLR_ALL  &bt BT_PRV      &bt BT_NXT       &trans        &out OUT_TOG
&to 0      &mkp MB1        &mmv MOVE_UP    &mkp MB2         &none             &none       &bootloader                                      &bootloader  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4  &trans
&trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &none       &sys_reset                                       &sys_reset   &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT  &trans        &trans
&trans     &kp SYSREQ      &kp PSCRN       &trans           &trans            &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &mkp MB4   &mkp MB5     &trans          &trans          &trans          &trans           &trans        &trans
&trans     &trans          &trans          &trans           &kp C_PLAY_PAUSE              &kp C_PREVIOUS     &kp C_NEXT         &mkp LCLK  &mkp RCLK                    &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_UP  &mmv MOVE_RIGHT
            >;
        };
    };
};
